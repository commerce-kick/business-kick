# ---------------------------------------------------------------------------
# Salesforce B2B Commerce (Commerce on Lightning / Salesforce Core)
# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file IS committed, so every
# value here must stay a placeholder — never a real org URL, Id or secret.
#
# Full setup walkthrough: docs/salesforce-setup.md

# Your org's My Domain URL — no trailing slash.
# Must NOT be login.salesforce.com or test.salesforce.com: those are login
# hosts and the Data API rejects them with URL_NOT_RESET. Validated at startup.
SF_INSTANCE_URL=https://mycompany.my.salesforce.com

# The Experience Cloud site that fronts the store. Identity endpoints
# (/services/oauth2/*, /services/auth/headless/*) are called against this host,
# NOT the raw org host.
SF_EXPERIENCE_SITE_URL=https://mycompany.my.site.com/mystore

# 18-character WebStore record Id (starts with 0ZE).
SF_WEBSTORE_ID=0ZExx0000000000XXX

# Pinned Connect REST API version.
SF_API_VERSION=v63.0

# External Client App credentials.
# Required OAuth scopes: `api` AND `refresh_token, offline_access`.
# `Full access (full)` alone is NOT sufficient — see docs/salesforce-setup.md §2.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Absolute public origin of this storefront. Used for canonical URLs, OG tags
# and sitemap entries — must be the real production origin, not a preview URL,
# or preview deploys will emit canonicals pointing at themselves.
# VITE_-prefixed because route head() functions run on the client too and need
# the same value. Do NOT put secrets behind a VITE_ prefix: Vite inlines them
# into the client bundle.
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Identity used for anonymous catalog traffic.
#   guest_user         → Experience Cloud guest user (minimal permissions, tied
#                        to the store's guest buyer account). Preferred.
#                        Requires "Enable Code and Credentials Flow for Guest
#                        Users" on the External Client App.
#   client_credentials → the app's named Run-As user. Anonymous visitors inherit
#                        that user's catalog visibility, so never point Run-As
#                        at a System Administrator.
SF_GUEST_MODE=guest_user

# Verbose SDK logging: every Salesforce request with timing, token acquisition,
# and auth failures annotated with the specific admin fix. Tokens and secrets
# are redacted. Errors always log regardless of this flag.
# Leave off in production — it emits a line per API call.
SF_DEBUG=0
